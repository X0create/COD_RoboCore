{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "host-tests",
      "displayName": "电脑侧单元测试（gcc，Debug）",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${hostSystemName}/host-tests",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "RM_HOST_TESTS": "ON"
      },
      "vendor": {
        "jetbrains.com/clion": {
          "toolchain": "MinGW"
        }
      }
    },
    {
      "name": "h723-debug",
      "displayName": "DM-MC02 固件（arm-none-eabi-gcc，Debug）",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${hostSystemName}/h723-debug",
      "toolchainFile": "${sourceDir}/cmake/toolchain-arm-gcc.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "RM_BOARD": "dm_mc02"
      },
      "vendor": {
        "jetbrains.com/clion": {
          "toolchain": "MinGW"
        }
      }
    },
    {
      "name": "c-debug",
      "displayName": "大疆 C 板固件（arm-none-eabi-gcc，Debug）",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${hostSystemName}/c-debug",
      "toolchainFile": "${sourceDir}/cmake/toolchain-arm-gcc.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "RM_BOARD": "dji_c"
      },
      "vendor": {
        "jetbrains.com/clion": {
          "toolchain": "MinGW"
        }
      }
    },
    {
      "name": "h723-handguide",
      "displayName": "MC02 DM4340 单电机手拖测试（待台架验证）",
      "inherits": "h723-debug",
      "binaryDir": "${sourceDir}/build/${hostSystemName}/h723-handguide",
      "cacheVariables": {
        "RM_HAND_GUIDE": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "host-tests",
      "configurePreset": "host-tests"
    },
    {
      "name": "h723-debug",
      "configurePreset": "h723-debug"
    },
    {
      "name": "c-debug",
      "configurePreset": "c-debug"
    },
    {
      "name": "h723-handguide",
      "configurePreset": "h723-handguide"
    }
  ],
  "testPresets": [
    {
      "name": "host-tests",
      "configurePreset": "host-tests",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
