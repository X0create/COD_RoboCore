<mujoco model="C PID single motor">
  <!-- 输出轴的理想惯量和粘性阻尼，仅用于接口验证，不是 M3508 的辨识结果。 -->
  <option gravity="0 0 0" integrator="implicitfast"/>
  <visual><global azimuth="135" elevation="-25"/></visual>
  <worldbody>
    <light pos="0 0 2"/>
    <geom type="plane" size="1 1 0.1" rgba="0.2 0.25 0.3 1"/>
    <geom type="box" pos="0 0 0.1" size="0.14 0.14 0.1" rgba="0.4 0.4 0.4 1"/>
    <body name="rotor" pos="0 0 0.3">
      <inertial pos="0 0 0" mass="1" diaginertia="0.01 0.01 0.02"/>
      <joint name="shaft" type="hinge" axis="0 0 1" damping="0.02"/>
      <geom type="cylinder" size="0.1 0.025" rgba="0.1 0.6 0.9 1"/>
      <!-- 红色条随轴转动，方便看到旋转方向。 -->
      <geom type="box" pos="0.05 0 0.03" size="0.045 0.008 0.005"
            rgba="1 0.2 0.15 1" contype="0" conaffinity="0"/>
    </body>
  </worldbody>
  <actuator>
    <!-- gear=1：ctrl 就是输出轴力矩 N·m，没有第二层速度环或减速比换算。 -->
    <motor name="drive" joint="shaft" gear="1"/>
  </actuator>
</mujoco>
